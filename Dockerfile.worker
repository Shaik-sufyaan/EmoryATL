# Dockerfile for Celery Worker
# Updated to Python 3.13 with compatible pydantic versions
FROM python:3.13.1-slim

# Set working directory
WORKDIR /app

# Install system dependencies for audio processing and ML
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies with retry logic and timeout settings
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    --retries 5 \
    --timeout 300 \
    --default-timeout=300 \
    -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p outputs temp background_music beats

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV C_FORCE_ROOT=true

# Run Celery worker
CMD ["celery", "-A", "app.tasks", "worker", "--loglevel=info", "--concurrency=2", "--max-tasks-per-child=10"]
